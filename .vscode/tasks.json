{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "cargo build --workspace",
      "group": "build",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "cargo test --workspace",
      "group": "test",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "server (memory)",
      "type": "shell",
      "command": "cargo run -p omonat-server",
      "options": {
        "env": {
          "OMONAT_DEV": "1",
          "OMONAT_RECONCILE_SECS": "300",
          "RUST_LOG": "info,tower_http=warn"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "server (postgres)",
      "type": "shell",
      "command": "cargo run -p omonat-server",
      "options": {
        "env": {
          "OMONAT_DEV": "1",
          "OMONAT_RECONCILE_SECS": "300",
          "DATABASE_URL": "postgres://omonat_app:omonat_app_dev@127.0.0.1:5442/omonat",
          "DATABASE_OWNER_URL": "postgres://omonat_owner:omonat_owner_dev@127.0.0.1:5442/omonat",
          "RUST_LOG": "info,tower_http=warn"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "web (vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
